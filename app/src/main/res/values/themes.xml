<?xml version="1.0" encoding="utf-8"?>
<!-- The window theme behind Compose; the screens draw their own Material 3 theme. -->
<resources>
    <style name="Theme.Qadam" parent="android:Theme.Material.NoActionBar" />
    <!-- Transparent activity that only receives NFC tag taps. -->
    <style name="Theme.Qadam.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <!-- Answer buttons in the sampling notification. -->
    <style name="Qadam.LabelButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Qadam.LabelButton.Big">
        <item name="android:layout_height">44dp</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
